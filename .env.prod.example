# Шаблон .env для production-деплоя под docker-server (Caddy + общий postgres).
# Скопируйте в .env рядом с docker-compose.prod.yml и заполните.
# Это НЕ локальный env.example (там свой postgres и порты наружу).

# Публичный домен (должен резолвиться на IP сервера; TLS выпустит Caddy).
PUBLIC_DOMAIN=example.com

ENV=production

# ── Подключение к ОБЩЕМУ postgres сервера (сеть shared-db) ──────────────
# Базу/пользователя/пароль создаёт docker-server/add-db.sh:
#   ./add-db.sh gravel_bot gravel_bot
# Хост всегда `postgres` (имя общего контейнера), порт 5432, ssl выключен.
DB_NAME=gravel_bot
DB_USER=gravel_bot
DB_PASSWORD=
DB_SSLMODE=disable

# ── Telegram bot ───────────────────────────────────────────────────────
BOT_TOKEN=
ADMIN_CHAT_ID=0
PUBLIC_CHAT_ID=0
BOT_MESSAGES_CHAT_ID=0
BOT_DEBUG=false
BOT_SESSION_TIMEOUT=30m
# Пароль админ-команд бота (/notify_missing_gift); пусто = команды отключены
ADMIN_ACTIONS_PASSWORD=
# По умолчанию вычисляется как https://${PUBLIC_DOMAIN}/miniapp/leaderboard
# (открывает лидерборд; каталог призов — вкладка). Задайте, только если нужен
# другой URL Mini App.
MINIAPP_URL=

# ── API / JWT ──────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Бэкап БД в Telegram (scripts/backup-telegram.sh, cron на хосте) ─────
# Скрипт читает POSTGRES_*-имена и делает `docker exec <container> pg_dump`.
# Контейнер — общий postgres сервера; значения дублируют DB_* выше намеренно,
# т.к. это другой потребитель (скрипт бэкапа, не compose).
BACKUP_TELEGRAM_ID=
POSTGRES_CONTAINER=postgres
POSTGRES_DB=gravel_bot
POSTGRES_USER=gravel_bot
POSTGRES_PASSWORD=
