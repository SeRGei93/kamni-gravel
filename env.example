# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_DEBUG=false
BOT_SESSION_TIMEOUT=30m
ADMIN_CHAT_ID=0
PUBLIC_CHAT_ID=0
BOT_MESSAGES_CHAT_ID=-1003805902788
# Public HTTPS URL for Telegram Mini App, for example https://example.com/miniapp/gifts
MINIAPP_URL=
# Password required by admin-chat actions such as /notify_missing_gift (empty = commands disabled)
ADMIN_ACTIONS_PASSWORD=
# Telegram chat/user id that hourly DB backups are sent to (scripts/backup-telegram.sh)
BACKUP_TELEGRAM_ID=

# PostgreSQL Database Configuration (source of truth for DB name/user/password/port)
POSTGRES_DB=gravel_bot
POSTGRES_USER=gravel
POSTGRES_PASSWORD=gravel_password
POSTGRES_PORT=5432

# Database Connection (for backend services).
# Name/user/password/port are reused from the POSTGRES_* values above (see docker-compose.yml).
DB_HOST=postgres
DB_SSLMODE=disable

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_PUBLIC_PORT=18080
# Host port for the frontend (dashboard) container. Override if 3000 is busy locally.
FRONTEND_PORT=3000
# Must be public HTTPS in non-local Telegram Mini App environments
NEXT_PUBLIC_API_URL=http://localhost:18080
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Include the Mini App frontend origin when not using "*"; miniapp calls send X-Telegram-Init-Data
ALLOWED_ORIGINS=*

# File storage
FILE_STORAGE_PATH=/app/storage

# Miniapp first-screen gift catalog cache (backend, file-backed).
# Directory should be a persistent volume to survive container recreation.
MINIAPP_CACHE_DIR=/app/cache/miniapp
# Backstop TTL; the cache is also invalidated immediately when a gift is approved/edited/deleted.
MINIAPP_GIFTS_CACHE_TTL=1h

# Environment
ENV=local

# Production-деплой (Caddy + общий postgres) использует отдельный шаблон —
# см. .env.prod.example и DEPLOY.md.
